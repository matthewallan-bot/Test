# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Neon / Postgres (any Postgres URL works; Neon free tier recommended)
# Example Neon: postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Set to false only for local non-TLS Postgres
DATABASE_SSL=true

# Payments — Stripe (test keys only in .env.local — never commit secrets)
PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Cloudflare R2 (S3-compatible) for merch images + self-hosted audio
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=fixed-reaction
R2_PUBLIC_BASE_URL=https://cdn.example.com
